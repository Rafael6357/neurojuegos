<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_gestion_jugadores">

    <TextView
        android:id="@+id/titulo_gestion_jugadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="4dp"
        android:text="Gestión de Jugadores"
        android:textColor="#FF9800"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/spinner_usuarios"
        android:layout_width="253dp"
        android:layout_height="31dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="108dp"
        android:background="@color/white"
        android:prompt="@string/seleccionar_usuario"
        android:textColor="#FF9800"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textviewSeleccionarUsuario"
        android:layout_width="334dp"
        android:layout_height="34dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="56dp"
        android:shadowColor="@color/black"
        android:shadowDx="9"
        android:shadowDy="9"
        android:shadowRadius="8"
        android:text="Seleccione su Usuario:"
        android:textColor="#FF9800"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/boton_registrar_nuevo_usuario"
        android:layout_width="129dp"
        android:layout_height="53dp"
        android:layout_marginStart="108dp"
        android:layout_marginTop="312dp"
        android:background="@drawable/imagen_boton_naranja"
        android:text="Registrar Nuevo Usuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/chains2"
        android:layout_width="66dp"
        android:layout_height="100dp"
        android:layout_marginStart="192dp"
        android:layout_marginTop="340dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chains" />

    <EditText
        android:id="@+id/rellenar_edad"
        android:layout_width="180dp"
        android:layout_height="41dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="460dp"
        android:background="@color/white"
        android:hint="Edad"
        android:inputType="number"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/boton_registrar"
        android:layout_width="129dp"
        android:layout_height="53dp"
        android:layout_marginStart="108dp"
        android:layout_marginTop="520dp"
        android:background="@drawable/imagen_boton_naranja"
        android:text="Guardar"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/icono_edad"
        android:layout_width="26dp"
        android:layout_height="32dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="460dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_edad" />

    <ImageView
        android:id="@+id/chains1"
        android:layout_width="66dp"
        android:layout_height="100dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="340dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chains" />

    <EditText
        android:id="@+id/rellenar_nombre"
        android:layout_width="180dp"
        android:layout_height="41dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="412dp"
        android:background="@color/white"
        android:hint="Nombre"
        android:inputType="text"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/icono_usuario"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="412dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icono_usuario" />



    <ImageView
        android:id="@+id/icon_triangulo_invertido"
        android:layout_width="25dp"
        android:layout_height="31dp"
        android:layout_marginStart="272dp"
        android:layout_marginTop="108dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_triangulo_invertido" />

    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="259dp"
        android:layout_height="130dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="160dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/imagen_boton_naranja" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="82dp"
        android:layout_marginTop="175dp"
        android:fontFamily="@font/boba_cups"
        android:text="Nombre : "
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="216dp"
        android:fontFamily="@font/boba_cups"
        android:text="Edad : "
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="256dp"
        android:fontFamily="@font/boba_cups"
        android:text="Puntuaje : "
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tablero_puntuaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="160dp"
        android:layout_marginTop="256dp"
        android:fontFamily="@font/boba_cups"
        android:text=" "
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tablero_nombre"
        android:layout_width="72dp"
        android:layout_height="17dp"
        android:layout_marginStart="160dp"
        android:layout_marginTop="172dp"
        android:fontFamily="@font/boba_cups"
        android:text=" "
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tablero_edad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="160dp"
        android:layout_marginTop="216dp"
        android:fontFamily="@font/boba_cups"
        android:text=" "
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/button_panel_niveles_gestion_jugadores"
        android:layout_width="86dp"
        android:layout_height="70dp"
        android:layout_marginStart="128dp"
        android:layout_marginTop="600dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/casa_naranja_icono"
        app:lottie_speed="1.0" />

    <ImageView
        android:id="@+id/boton_ranking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_panel_niveles_gestion_jugadores"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="600dp"
        android:layout_marginEnd="256dp"
        android:contentDescription="Ranking De Jugadores"
        android:src="@drawable/boton_ranking3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/menu_panel"
        android:layout_width="100dp"
        android:layout_height="75dp"
        android:layout_below="@id/button_panel_niveles_gestion_jugadores"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="600dp"
        android:layout_marginEnd="28dp"
        android:contentDescription="Ranking De Jugadores"
        android:src="@drawable/menu_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>